{
  "name": "ai-project-harness",
  "version": "0.0.25-rc.6",
  "private": false,
  "license": "MIT",
  "description": "Local-first AI project continuity harness desktop MVP",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "check:local": "npm test && npm run build",
    "start": "electron .",
    "smoke:app": "node scripts/app-smoke.mjs",
    "smoke:mcp-e2e": "node scripts/mcp-e2e-smoke.mjs",
    "smoke:portable": "node scripts/portable-smoke.mjs",
    "smoke:packaged-ui": "node scripts/packaged-ui-smoke.mjs",
    "check:release": "npm run check && npm run smoke:renderer && npm run smoke:app",
    "qualify:release": "node scripts/release-qualification.mjs",
    "audit:package": "node scripts/package-audit.mjs",
    "package:win": "electron-builder --win portable",
    "package:local": "electron-builder --win portable",
    "prepackage:win": "node scripts/prepackage-gate.mjs && npm run check:release",
    "prepackage:local": "node scripts/prepackage-gate.mjs && npm run check:local",
    "test": "node --test",
    "smoke:renderer": "npm run build && node scripts/renderer-onboarding-smoke.mjs",
    "check:packaged-integrity": "node scripts/packaged-runtime-integrity.mjs",
    "cleanup:smoke": "node scripts/cleanup-test-artifacts.mjs",
    "mark-progress": "node scripts/mark-progress.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.17.1",
    "electron": "41.3.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.aiprojectharness.desktop",
    "productName": "AI Project Harness",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "integrations",
        "to": "integrations",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "protocol",
        "to": "protocol",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "harness-projects",
        "to": "harness-projects",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "harness-runtime/electron",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "integrations/harness-runtime-package.json",
        "to": "harness-runtime/package.json"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "assets/brand/electron-atom.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Project-Harness-${version}-portable.${ext}"
    }
  }
}
